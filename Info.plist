<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets the game run above 60 fps on ProMotion (120 Hz) iPhones. Xcode merges this with the generated Info.plist keys. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Game controllers (pre-TestFlight): the game reads controller input itself (flippers, plunger, Menu, A), and it
	     supports the Extended Gamepad profile (Xbox, PlayStation and MFi controllers). -->
	<!-- App Store / TestFlight: no encryption beyond Apple's own (skips the export-compliance question on every
	     upload), and the App Store category. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.arcade-games</string>
	<key>GCSupportsControllerUserInteraction</key>
	<true/>
	<key>GCSupportedGameControllers</key>
	<array>
		<dict>
			<key>ProfileName</key>
			<string>ExtendedGamepad</string>
		</dict>
	</array>
</dict>
</plist>
